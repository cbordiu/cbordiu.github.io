---
// Real bright stars around η Car (see scripts/build_starfield.py), drawn as a static SVG.
// JS adds depth parallax: five brightness layers drift with the pointer (bright = near = moves most), the whole field with scroll.
// Resting the pointer on a star for DWELL ms reveals its name (proper name, designation, spectral type, V).
import { starfield } from "../lib/data";
const W = 1440, H = 600;
const [cx, cy] = (starfield as any).centre_xy as [number, number];

/** Four-point sparkle with a thin waist: reads as a star, not a dot. */
const sparkle = (L: number, w: number) =>
  `M0 ${-L}L${w} ${-w}L${L} 0L${w} ${w}L0 ${L}L${-w} ${w}L${-L} 0L${-w} ${-w}Z`;

const stars = starfield.stars.map((s) => {
  const r = +Math.max(0.55, 2.6 - 0.42 * s.v).toFixed(2);
  const spike = s.v < 2.6 ? r * 5.5 : s.v < 3.8 ? r * 3.4 : 0;
  return {
    x: +(s.x * W).toFixed(1),
    y: +(s.y * H).toFixed(1),
    r,
    spike: spike ? sparkle(+spike.toFixed(1), +(r * 0.32).toFixed(2)) : null,
    o: +Math.min(1, Math.max(0.45, 1.15 - 0.12 * s.v)).toFixed(2),
    glow: s.v < 2.2,
    tint: s.bv < 0 ? "hot" : s.bv > 1.1 ? "cool" : "",
    label: { id: (s as any).id, name: (s as any).name ?? "", sp: (s as any).sp, v: s.v.toFixed(2) },
    // Parallax depth by brightness: bright stars read as "in front" and move most.
    layer: s.v < 2 ? 4 : s.v < 3 ? 3 : s.v < 4 ? 2 : s.v < 5 ? 1 : 0,
  };
});
// Relative pointer travel per layer, background → foreground.
const DEPTHS = [0.06, 0.16, 0.34, 0.62, 1];
const layers = DEPTHS.map((_, i) => stars.filter((s) => s.layer === i));
const eta = { x: +(cx * W).toFixed(1), y: +(cy * H).toFixed(1) };
---
<div class="starfield" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="sf-glow">
        <stop offset="0" stop-color="var(--field-star)" stop-opacity=".4" />
        <stop offset="1" stop-color="var(--field-star)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="sf-gold">
        <stop offset="0" stop-color="var(--gold)" stop-opacity=".55" />
        <stop offset="1" stop-color="var(--gold)" stop-opacity="0" />
      </radialGradient>
    </defs>
    {layers.map((layer, i) => (
      <g class="layer" data-depth={DEPTHS[i]}>
        <g class="field">
          {layer.filter((s) => s.glow).map((s) => <circle class="halo" cx={s.x} cy={s.y} r={s.r * 5} fill="url(#sf-glow)" />)}
          {layer.map((s) => (
            <g class:list={["st", s.tint]} transform={`translate(${s.x} ${s.y})`} opacity={s.o}
               data-id={s.label.id} data-name={s.label.name} data-sp={s.label.sp} data-v={s.label.v}>
              {s.spike && <path class="spike" d={s.spike} />}
              <circle r={s.r} />
            </g>
          ))}
        </g>
        {i === 3 && (
          <g class="st eta" transform={`translate(${eta.x} ${eta.y})`}
             data-id="η Car" data-name="" data-sp="LBV, massive binary" data-v="≈ 4">
            <circle class="eta-glow" r="22" fill="url(#sf-gold)" />
            <path d={sparkle(17, 1.1)} />
            <path d={sparkle(8, 0.9)} transform="rotate(45)" opacity=".55" />
            <circle r="3" />
          </g>
        )}
      </g>
    ))}
  </svg>
</div>
<div class="star-probe" aria-hidden="true">
  <svg class="ring" viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" pathLength="100" /></svg>
  <div class="tag"><span class="n"></span><span class="d"></span></div>
</div>

<script>
  const svg = document.querySelector<SVGSVGElement>(".starfield svg");
  const host = svg?.closest<HTMLElement>(".hero");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (svg && host) {
    const layers = [...svg.querySelectorAll<SVGGElement>(".layer")];
    const MAX = 48; // px shift of the nearest layer with the pointer at the hero's edge
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.05;
      y += (ty - y) * 0.05;
      layers.forEach((l) => {
        const d = +(l.dataset.depth ?? 0);
        l.style.transform = `translate(${(x * MAX * d).toFixed(2)}px, ${(y * MAX * d).toFixed(2)}px)`;
      });
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(loop) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
    if (!still && matchMedia("(hover: hover)").matches) {
      host.addEventListener("pointermove", (e) => {
        const b = host.getBoundingClientRect();
        tx = -((e.clientX - b.left) / b.width - 0.5) * 2;
        ty = -((e.clientY - b.top) / b.height - 0.5) * 2;
        kick();
      });
      host.addEventListener("pointerleave", () => { tx = 0; ty = 0; kick(); });
    }
    // Dwell-to-reveal star names.
    const DWELL = 1500, NEAR = 16, FAR = 30;
    const probe = host.querySelector<HTMLElement>(".star-probe")!;
    const tagN = probe.querySelector<HTMLElement>(".n")!;
    const tagD = probe.querySelector<HTMLElement>(".d")!;
    const all = [...svg.querySelectorAll<SVGGElement>(".st")];
    let cand: SVGGElement | null = null, timer = 0, px = 0, py = 0, follow = 0;
    const centre = (g: SVGGElement) => {
      const b = g.querySelector("circle:last-of-type")!.getBoundingClientRect();
      return [b.left + b.width / 2, b.top + b.height / 2];
    };
    const place = () => {
      if (!cand) return;
      const h = host.getBoundingClientRect(), [x, y] = centre(cand);
      probe.style.transform = `translate(${x - h.left}px, ${y - h.top}px)`;
      follow = requestAnimationFrame(place);
    };
    const reset = () => {
      cand = null; clearTimeout(timer); cancelAnimationFrame(follow);
      probe.classList.remove("dwell", "shown");
    };
    const check = () => {
      let best: SVGGElement | null = null, bd = Infinity;
      for (const g of all) {
        // Bright stars win close calls: each magnitude brighter than V 4 counts as 3 px nearer.
        const [x, y] = centre(g), v = parseFloat(g.dataset.v?.replace("≈ ", "") ?? "5");
        const d = Math.hypot(x - px, y - py) - Math.max(0, 4 - v) * 3;
        if (d < bd) { bd = d; best = g; }
      }
      if (cand) {
        const [cx, cy] = centre(cand);
        if (Math.hypot(cx - px, cy - py) < FAR) return; // still resting on the same star
      }
      reset();
      if (!best || bd >= NEAR) return;
      cand = best;
      const { id = "", name = "", sp = "", v = "" } = best.dataset;
      tagN.textContent = name || id;
      tagD.textContent = [name ? id : "", sp, `V ${v}`].filter(Boolean).join(" · ");
      probe.classList.toggle("gold", best.classList.contains("eta"));
      place();
      void probe.offsetWidth; // restart the ring animation
      probe.classList.add("dwell");
      timer = window.setTimeout(() => probe.classList.add("shown"), DWELL);
    };
    let probing = false;
    if (matchMedia("(hover: hover)").matches) {
      host.addEventListener("pointermove", (e) => {
        px = e.clientX; py = e.clientY;
        if (!probing) { probing = true; requestAnimationFrame(() => { check(); probing = false; }); }
      });
      host.addEventListener("pointerleave", reset);
    }

    let ticking = false;
    addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        if (!still) svg.style.transform = `translate3d(0, ${Math.min(scrollY, 900) * 0.18}px, 0)`;
        ticking = false;
      });
    }, { passive: true });
  }
</script>

<style>
  .starfield {
    position: absolute; inset: 0; overflow: hidden; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
  }
  svg { width: 100%; height: 115%; will-change: transform; }
  .layer { will-change: transform; }
  .field { fill: var(--field-star); opacity: var(--field-opacity); transition: opacity .3s ease; }
  .field .hot { fill: var(--star-hot); }
  .field .cool { fill: var(--star-cool); }
  .spike { opacity: .75; }
  .halo { opacity: var(--halo); }
  .eta { fill: var(--gold); }
  .eta-glow { animation: breathe 6s ease-in-out infinite; transform-origin: center; }
  @keyframes breathe { 50% { opacity: .55; } }
  @media (prefers-reduced-motion: reduce) { .eta-glow { animation: none; } }

  /* Dwell-to-reveal label */
  .star-probe { position: absolute; left: 0; top: 0; z-index: 3; pointer-events: none; opacity: 0; transition: opacity .3s ease; }
  .star-probe.dwell { opacity: 1; }
  .ring { position: absolute; width: 2.1rem; height: 2.1rem; transform: translate(-50%, -50%) rotate(-90deg); overflow: visible; }
  .ring circle { fill: none; stroke: var(--gold); stroke-width: 1; stroke-dasharray: 100; stroke-dashoffset: 100; opacity: .85; }
  .dwell .ring circle { animation: dwell 1.5s linear forwards; }
  @keyframes dwell { to { stroke-dashoffset: 0; } }
  .tag {
    position: absolute; left: 1.35rem; top: -1.45rem; white-space: nowrap;
    display: flex; flex-direction: column; gap: .1rem;
    padding: .3rem .55rem .35rem; border-radius: 3px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    opacity: 0; transform: translateY(4px); transition: opacity .5s ease, transform .5s ease;
  }
  .shown .tag { opacity: 1; transform: none; }
  .tag .n { font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: var(--fg); line-height: 1.1; }
  .gold .tag .n { color: var(--gold); }
  .tag .d { font-family: var(--mono); font-size: .6rem; letter-spacing: .05em; color: var(--muted); }
</style>
