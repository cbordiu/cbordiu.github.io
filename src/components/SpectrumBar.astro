---
// Scroll progress drawn as a spectrum along the header's bottom edge (docs/03-visual-design.md). Home page only.
// Each home-page section contributes one unlabelled emission line; the trace is revealed as you scroll.
// amp / w in px (w = Gaussian sigma). Shapes loosely follow real transitions (CO, 13CO, SiO, HCN, H I, SO, CS, HCO+, N2H+).
const LINES: Record<string, { amp: number; w: number; double?: boolean }> = {
  about:      { amp: 12, w: 1.4 },
  trajectory: { amp: 8, w: 1.2 },
  research:   { amp: 11, w: 1.6, double: true },
  projects:   { amp: 7, w: 1.1 },
  software:   { amp: 9, w: 2 },
  papers:     { amp: 10, w: 1.2 },
  talks:      { amp: 6, w: 1.1 },
  press:      { amp: 7, w: 1.2 },
  contact:    { amp: 5, w: 1.1 },
};
---
<div class="spectrum" aria-hidden="true" data-lines={JSON.stringify(LINES)}>
  <svg preserveAspectRatio="none">
    <defs><clipPath id="spec-clip"><rect class="reveal" x="0" y="-20" height="60" width="0" /></clipPath></defs>
    <path class="trace" clip-path="url(#spec-clip)" />
    <circle class="head" r="2" />
  </svg>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".spectrum");
  if (root) {
    type Line = { amp: number; w: number; double?: boolean };
    const LINES = JSON.parse(root.dataset.lines!) as Record<string, Line>;
    const svg = root.querySelector("svg")!;
    const trace = root.querySelector<SVGPathElement>(".trace")!;
    const reveal = root.querySelector<SVGRectElement>(".reveal")!;
    const head = root.querySelector<SVGCircleElement>(".head")!;
    const H = 16, BASE = 14; // svg height and baseline (px)
    const NOISE = 3.2;       // peak-to-peak-ish noise amplitude (px)
    let W = 0;

    // Deterministic pseudo-random noise, so the trace is identical on every visit.
    const noise = (i: number) => {
      const s = Math.sin(i * 12.9898 + 78.233) * 43758.5453;
      return s - Math.floor(s) - 0.5;
    };
    const progress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      return max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    };

    const layout = () => {
      W = innerWidth;
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      const max = document.documentElement.scrollHeight - innerHeight;
      const marks = Object.entries(LINES).flatMap(([id, l]) => {
        const el = document.getElementById(id);
        if (!el || max <= 0) return [];
        // A section's line sits where the scan is when that section reaches 40% of the viewport.
        const p = Math.min(1, Math.max(0, (el.offsetTop - innerHeight * 0.4) / max));
        return [{ ...l, x: 6 + p * (W - 12) }];
      });
      let d = "", smooth = 0;
      for (let x = 0; x <= W; x += 1) {
        smooth = smooth * 0.3 + noise(x) * 0.7;
        let y = smooth * NOISE;
        for (const m of marks) {
          const g = (c: number, a: number) => a * Math.exp(-0.5 * ((x - c) / m.w) ** 2);
          y += m.double ? g(m.x - m.w * 1.3, m.amp * 0.8) + g(m.x + m.w * 1.3, m.amp) : g(m.x, m.amp);
        }
        d += `${x ? "L" : "M"}${x} ${(BASE - y).toFixed(2)}`;
      }
      trace.setAttribute("d", d);
      update();
    };

    let ticking = false;
    const update = () => {
      const x = 6 + progress() * (W - 12);
      reveal.setAttribute("width", String(x));
      head.setAttribute("cx", String(x));
      head.setAttribute("cy", String(BASE));
      ticking = false;
    };

    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener("resize", layout);
    // Re-measure once fonts and images have settled the layout.
    layout();
    addEventListener("load", layout);
    document.fonts?.ready.then(layout);
  }
</script>

<style>
  .spectrum { position: absolute; left: 0; right: 0; bottom: -1px; height: 16px; pointer-events: none; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .trace { fill: none; stroke: var(--star); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: .75; stroke-linejoin: round; }
  .head { fill: var(--gold); filter: drop-shadow(0 0 3px var(--gold)); }
</style>
