---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Starfield from "../components/Starfield.astro";
import Constellation from "../components/Constellation.astro";
import SkyCoord from "../components/SkyCoord.astro";
import ScrollBold from "../components/ScrollBold.astro";
import LineSymbol from "../components/LineSymbol.astro";
import TalkItem from "../components/TalkItem.astro";
import { profile, metrics, paperById, papers, talks, press, venue, authorParts, type Paper } from "../lib/data";

const sky = profile.sky;
const m = metrics.headline;
const pinned = (profile.pinned as { id: string; image: string; credit: string; note: string }[])
  .map((x) => ({ ...x, paper: paperById(x.id) as Paper }))
  .filter((x) => x.paper);
const initials = profile.name.split(" ").map((w: string) => w[0]).join("");
const [given, ...rest] = profile.name.split(" ");
const TALKS_SHOWN = 6;
// Newest refereed article of any role; updates automatically with the ADS pipeline.
const latest = papers.find((p) => p.refereed && p.kind === "article")!;
const latestAuthors = authorParts(latest);
---
<Base>
  <!-- Hero -->
  <div class="hero">
    <Starfield />
    <div class="wrap hero-inner">
      <div class="intro">
        <p class="label roles">{profile.roles.join(" / ")}</p>
        <h1>{given} <span class="surname">{rest.join(" ")}</span></h1>
        <p class="where">{profile.position} · {profile.institution.replace(/.*\((.*)\)/, "$1")}, {profile.city.split(",")[0]}</p>
        <p class="tagline">{profile.tagline}</p>
        <p class="metrics mono">
          <span><b>{metrics.counts.refereed}</b> refereed papers</span>
          <span><b>{metrics.counts.first_author}</b> as first author</span>
          <span>h-index <b>{m.h_index}</b></span>
          <span><b>{m.citations}</b> citations</span>
          <span class="src">{m.source}</span>
        </p>
      </div>
      <div class="portrait">
        {profile.photo
          ? <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="220" height="220" />
          : <div class="placeholder" role="img" aria-label="Portrait placeholder"><span>{initials}</span></div>}
      </div>
      <div class="pointing"><SkyCoord sky={sky.hero} compact /></div>
    </div>
  </div>

  <Section id="about" index="01" label="About">
    <ScrollBold paragraphs={profile.about} />
  </Section>

  <Section id="trajectory" index="02" label="Trajectory">
    <Constellation />
  </Section>

  <Section id="research" index="03" label="Research" wide>
    <ol class="lines">
      {profile.research.map((r: any, i: number) => (
        <li class="line">
          <span class="num"><LineSymbol name={r.symbol} /></span>
          <div>
            <h3>{r.title}</h3>
            <p class="kw mono">{r.keywords.join(" · ")}</p>
            <p class="desc">{r.text}</p>
            <ul class="line-links mono">
              {r.papers.map((id: string) => { const p = paperById(id); return p && <li><a href={p.links.doi ?? p.links.ads}>{p.journal} {p.year}</a></li>; })}
              {(r.links ?? []).map((l: any) => <li><a href={l.url}>{l.label}</a></li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="software" index="04" label="Software">
    <dl class="software">
      {profile.software.map((s: any) => (
        <div class="sw">
          <dt><a class="mono" href={s.url}>{s.name}</a></dt>
          <dd>{s.text}</dd>
        </div>
      ))}
    </dl>
    <p class="gh"><a href={profile.github}><svg class="gh-mark" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>More on GitHub · <span class="mono">github.com/cbordiu</span> <span class="arrow">↗</span></a></p>
  </Section>

  <Section id="projects" index="05" label="Projects">
    <h3 class="grp label">As principal investigator</h3>
    <ul class="projects">
      {profile.projects.pi.map((p: any) => (
        <li class="proj pi">
          <span class="when mono">{p.period}</span>
          <div>
            <p class="pt">{p.title}</p>
            <p class="pf mono">{p.funder}</p>
            <p class="pd">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <h3 class="grp label">As contributor</h3>
    <ul class="projects">
      {profile.projects.contributor.map((p: any) => (
        <li class="proj">
          <span class="when mono">{p.period ?? ""}</span>
          <div>
            <p class="pt">{p.title}</p>
            <p class="pf mono">{p.funder}{p.pi && <> · PI {p.pi}</>}</p>
            <p class="pd">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="papers" index="06" label="Selected papers" wide>
    <a class="latest" href={latest.links.doi ?? latest.links.ads}>
      <span class="beacon" aria-hidden="true"></span>
      <span class="l-label mono">Latest publication · {latest.date.replace(/^(\d{4})-(\d{2})$/, (_, y, m) => new Date(+y, +m - 1).toLocaleString("en", { month: "short" }) + " " + y)}</span>
      <span class="l-title">{latest.title}</span>
      <span class="l-meta mono">{latestAuthors.names.join(", ")}{latestAuthors.more > 0 && ` … (+${latestAuthors.more})`} · {venue(latest)}</span>
    </a>
    <ul class="posters">
      {pinned.map(({ paper: p, image, credit, note }) => (
        <li>
          <a class="poster" href={p.links.doi ?? p.links.ads}>
            <img src={image} alt="" loading="lazy" width="720" height="960" />
            <span class="credit mono">{credit}</span>
            <span class="cap">
              <span class="meta mono">{p.year} · {p.journal}</span>
              <span class="ttl">{p.title}</span>
              <span class="note">{note}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="all"><a href="/publications">All {papers.length} publications, by role and year <span class="arrow">→</span></a></p>
  </Section>

  <Section id="talks" index="07" label="Talks">
    <p class="talk-sum muted">{talks.length} contributions · {talks.filter((t) => t.kind === "invited").length} invited</p>
    <ul class="list">
      {talks.slice(0, TALKS_SHOWN).map((t) => <TalkItem t={t} />)}
    </ul>
    <details class="more">
      <summary class="mono"><span class="closed">Show all {talks.length} talks ↓</span><span class="opened">Show fewer ↑</span></summary>
      <ul class="list">
        {talks.slice(TALKS_SHOWN).map((t) => <TalkItem t={t} />)}
      </ul>
    </details>
  </Section>

  <Section id="press" index="08" label="Press & outreach">
    <ul class="list">
      {press.map((t) => (
        <li>
          <span class="year mono">{t.year}</span>
          <div>
            <p class="t">{t.url ? <a href={t.url}>{t.title}</a> : t.title}</p>
            <p class="e muted">{t.outlet}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="contact" index="09" label="Contact">
    <p class="lead">{profile.institution} · {profile.city}</p>
    <ul class="contact">
      {profile.contact.map((c: any) => (
        <li><a href={c.url}><span class="label">{c.label}</span><span class="v">{c.value}</span><span class="arrow">↗</span></a></li>
      ))}
    </ul>
  </Section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; padding: clamp(5rem, 14vh, 9rem) 0 clamp(3rem, 8vh, 5rem); overflow: hidden; }
  .hero-inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 3rem; align-items: center; }
  .intro .label { margin: 0 0 1.2rem; }
  .roles { color: var(--fg); opacity: .78; }
  .where { margin: 1rem 0 0; font-style: italic; font-size: 1.05rem; color: var(--muted); }
  h1 { font-size: clamp(2.9rem, 7.5vw, 5.4rem); letter-spacing: -0.015em; line-height: 1; font-weight: 350; }
  .tagline { font-size: clamp(1.2rem, 2.3vw, 1.55rem); font-style: italic; line-height: 1.4; max-width: 34rem; margin: 1.3rem 0 1.8rem; }
  .metrics { display: flex; flex-wrap: wrap; gap: .3rem 1.3rem; color: var(--muted); margin: 0; }
  .metrics b { color: var(--fg); font-weight: 500; }
  .metrics .src { opacity: .7; }
  .metrics .src::before { content: "· "; }
  .portrait img, .placeholder {
    width: clamp(8rem, 16vw, 12.5rem); aspect-ratio: 1; border-radius: 50%; object-fit: cover;
    border: 1px solid var(--line);
  }
  .placeholder {
    display: grid; place-items: center;
    background: radial-gradient(circle at 35% 30%, var(--bg-raised), var(--bg));
    box-shadow: inset 0 0 0 6px var(--bg), inset 0 0 0 7px var(--faint);
  }
  .placeholder span { font-style: italic; font-size: 2.6rem; color: var(--muted); letter-spacing: .04em; }
  .pointing { grid-column: 1 / -1; margin-top: 1.5rem; }
  @media (max-width: 40rem) {
    .hero-inner { grid-template-columns: 1fr; }
    .portrait { order: -1; }
  }

  .surname { color: var(--gold); }

  /* Research lines */
  .lines { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 3rem; }
  .line {
    display: grid; grid-template-columns: 2.6rem 1fr; gap: 0 1rem;
    padding: 1.9rem 0 2.2rem; border-top: 1px solid var(--faint);
  }
  @media (max-width: 52rem) { .lines { grid-template-columns: 1fr; } }
  .num { color: var(--muted); padding-top: .15rem; transition: color .3s ease, transform .6s ease; }
  .line:hover .num { transform: rotate(-8deg) scale(1.08); }
  .line:hover .num { color: var(--gold); }
  .line h3 { font-size: clamp(1.4rem, 2.6vw, 1.75rem); line-height: 1.2; }
  .kw { margin: .55rem 0 .9rem; color: var(--muted); font-size: .66rem; letter-spacing: .06em; }
  .desc { font-size: 1.02rem; margin: 0 0 .9rem; }
  .line-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .3rem 1.1rem; }
  .line-links a { text-decoration: none; color: var(--accent); }
  .line-links a::before { content: "→ "; }
  .line-links a:hover { text-decoration: underline; }

  /* Software */
  .gh { margin: 1.4rem 0 0; }
  .gh a { color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; gap: .55rem; }
  .gh-mark { width: 1.1rem; height: 1.1rem; fill: currentColor; flex: none; transform: translateY(-.12em); } /* optical alignment with the serif x-height */
  .gh a:hover { text-decoration: underline; }
  .gh .mono { font-size: .78rem; }
  .software { margin: 0; }
  .sw { display: grid; grid-template-columns: 9.5rem 1fr; gap: .2rem 1.5rem; padding: .9rem 0; border-top: 1px solid var(--faint); }
  .sw dt a { font-size: .82rem; color: var(--accent); text-decoration: none; }
  .sw dd { margin: 0; }
  @media (max-width: 34rem) { .sw { grid-template-columns: 1fr; } }

  /* Latest publication, with a pulsing beacon */
  .latest {
    position: relative; display: grid; grid-template-columns: 1.2rem 1fr; gap: .15rem .8rem; align-items: baseline;
    padding: 1rem 1.1rem 1.05rem; margin: 0 0 1.6rem; border: 1px solid var(--faint); border-radius: 4px;
    text-decoration: none; background: color-mix(in srgb, var(--bg-raised) 60%, transparent);
    transition: border-color .3s ease;
  }
  .latest:hover { color: inherit; border-color: color-mix(in srgb, var(--gold) 55%, transparent); }
  .latest > :not(.beacon) { grid-column: 2; }
  .beacon {
    grid-row: 1; align-self: center; justify-self: center; position: relative;
    width: .5rem; height: .5rem; border-radius: 50%; background: var(--gold);
    animation: blink 1.6s ease-in-out infinite;
  }
  .beacon::after {
    content: ""; position: absolute; inset: -.35rem; border-radius: 50%; border: 1px solid var(--gold);
    animation: ping 1.6s ease-out infinite;
  }
  @keyframes blink { 50% { opacity: .35; } }
  @keyframes ping { from { transform: scale(.4); opacity: .9; } to { transform: scale(1.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .beacon, .beacon::after { animation: none; } }
  .l-label { color: var(--accent); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; }
  .l-title { font-size: 1.12rem; line-height: 1.35; margin-top: .2rem; }
  .latest:hover .l-title { color: var(--accent); }
  .l-meta { color: var(--muted); margin-top: .25rem; }

  /* Selected papers: four posters */
  .posters {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem;
  }
  .poster {
    position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 4px;
    background: #05070d; color: #f3efe6; text-decoration: none; isolation: isolate;
  }
  .poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: filter .6s ease; filter: saturate(.9); }
  .poster::after {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top, rgba(5,7,13,.94) 0%, rgba(5,7,13,.72) 38%, rgba(5,7,13,0) 70%);
  }
  .poster:hover { color: #fff; }
  .poster:hover img, .poster:focus-visible img { filter: saturate(1.05); }
  .credit {
    position: absolute; z-index: 2; top: .6rem; right: .7rem; left: .7rem; text-align: right;
    font-size: .52rem; letter-spacing: .04em; color: rgba(255,255,255,.7);
    text-shadow: 0 1px 3px rgba(0,0,0,.8);
    opacity: .0; transition: opacity .4s ease;
  }
  .poster:hover .credit, .poster:focus-visible .credit { opacity: 1; }
  @media (hover: none) { .credit { opacity: .8; } }
  .cap { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; padding: 1rem .95rem 1.05rem; display: flex; flex-direction: column; gap: .35rem; }
  .cap .meta { font-size: .6rem; letter-spacing: .08em; color: #e9c27a; }
  .ttl { font-size: 1.02rem; line-height: 1.28; }
  .note {
    font-size: .84rem; font-style: italic; line-height: 1.35; color: rgba(243,239,230,.78);
    max-height: 0; opacity: 0; overflow: hidden; transition: max-height .5s ease, opacity .5s ease;
  }
  .poster:hover .note, .poster:focus-visible .note { max-height: 6rem; opacity: 1; }
  @media (hover: none) { .note { max-height: none; opacity: 1; } }
  @media (max-width: 64rem) { .posters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 34rem) {
    .posters { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: .8rem; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter) .4rem; }
    .posters li { flex: 0 0 72%; scroll-snap-align: start; }
  }
  .all { margin-top: 2.6rem; }
  .all a { color: var(--accent); text-decoration: none; font-size: 1.05rem; }
  .all a:hover { text-decoration: underline; }

  /* Talks & press */
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: .85rem 0; border-top: 1px solid var(--faint); }
  .list p { margin: 0; }
  .year { color: var(--muted); padding-top: .3rem; }
  .t { font-size: 1.02rem; line-height: 1.4; }
  .e { font-size: .9rem; font-style: italic; margin-top: .15rem !important; }
  .badge {
    display: inline-block; margin-left: .6rem; vertical-align: .15em;
    font-family: var(--mono); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px; padding: .05rem .5rem;
  }

  /* Projects */
  .grp { margin: 0 0 .6rem; font-weight: 400; }
  .projects + .grp { margin-top: 2.4rem; }
  .projects { list-style: none; margin: 0; padding: 0; }
  .proj { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding: 1rem 0 1.1rem; border-top: 1px solid var(--faint); }
  .proj p { margin: 0; }
  .when { color: var(--muted); padding-top: .25rem; }
  .pi .when { color: var(--accent); }
  .pt { font-size: 1.08rem; line-height: 1.35; }
  .pi .pt::before { content: "✦ "; color: var(--gold); font-size: .8em; vertical-align: .1em; }
  .pf { margin-top: .3rem !important; color: var(--muted); }
  .pd { margin-top: .45rem !important; font-size: .95rem; color: color-mix(in srgb, var(--fg) 85%, var(--muted)); }
  @media (max-width: 34rem) { .proj { grid-template-columns: 1fr; gap: .2rem; } }

  /* Talks: first few, rest behind a disclosure */
  .talk-sum { margin: 0 0 1rem; font-style: italic; }
  .more summary {
    cursor: pointer; list-style: none; margin-top: 1rem; color: var(--accent); width: fit-content;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .more summary::-webkit-details-marker { display: none; }
  .more .opened, .more[open] .closed { display: none; }
  .more[open] .opened { display: inline; }

  /* Contact */
  .lead { font-size: 1.1rem; font-style: italic; }
  .contact { list-style: none; margin: 1.2rem 0 0; padding: 0; }
  .contact a {
    display: grid; grid-template-columns: 9.5rem 1fr auto; align-items: baseline; gap: 1rem;
    padding: .9rem 0; border-top: 1px solid var(--faint); text-decoration: none;
  }
  .contact li:last-child a { border-bottom: 1px solid var(--faint); }
  .contact .v { font-size: 1.05rem; }
  .contact a:hover .label, .contact a:hover .arrow { color: var(--accent); }
</style>
